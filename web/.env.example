# ==========================================================
# Crédito Vecino · interfaz web (E1)
# ==========================================================
# Copie como web/.env si necesita cambiar algo. NADA de aquí es secreto:
# las variables VITE_* se incrustan en el código que recibe el navegador,
# así que aquí NUNCA va una contraseña, una clave de API ni DATABASE_URL.

# A dónde reenvía Vite las llamadas /api (el proceso `npm run api`).
VITE_API_DESTINO=http://127.0.0.1:3000

# Fecha de corte con la que abre la interfaz (AAAA-MM-DD). Se puede
# cambiar desde el encabezado. La interfaz nunca usa la fecha del reloj
# para calcular: la envía a la API, que se la pasa al núcleo.
VITE_FECHA_CORTE_INICIAL=2026-10-31
