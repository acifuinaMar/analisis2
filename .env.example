# ==========================================================
# Crédito Vecino · variables de entorno
# ==========================================================
# Copie este archivo como .env y complete los valores.
# El .env NO se versiona: contiene credenciales.
#
#   cp .env.example .env        (Linux / macOS)
#   copy .env.example .env      (Windows)
# ==========================================================


# ----------------------------------------------------------
# Paquete canónico de datos — OBLIGATORIA
# ----------------------------------------------------------
# Ruta de la carpeta con eventos.jsonl, eventos.sha256,
# clientes.csv, creditos.csv, pagos.csv, asesores.csv,
# politicas.json y corpus/.
#
# El repositorio ya incluye una copia en datos/, así que
# esto funciona tal cual:
CV_DATA_DIR=./datos


# ----------------------------------------------------------
# Base de datos PostgreSQL — OBLIGATORIA para cargar y para
# el servidor MCP sobre persistencia
# ----------------------------------------------------------
# Cadena de conexión completa. Debe apuntar a una base con la
# extensión pgvector disponible (el RAG la necesita).
#
# Formato:
#   postgresql://USUARIO:CONTRASENA@HOST:PUERTO/BASE
#
# Ejemplo local:
#   postgresql://postgres:miclave@localhost:5432/creditovecino
#
# Ejemplo Supabase (pooler):
#   postgresql://postgres.REF:CONTRASENA@aws-0-REGION.pooler.supabase.com:5432/postgres
DATABASE_URL=


# ----------------------------------------------------------
# Google Gemini — OBLIGATORIA solo para el módulo RAG (E4)
# ----------------------------------------------------------
# Se obtiene en https://aistudio.google.com/apikey
# Sin esta clave, el núcleo, el cargador, el servidor MCP y
# la suite de pruebas funcionan igual; solo quedan fuera la
# indexación del corpus, las respuestas del RAG y el chat.
GEMINI_API_KEY=


# ----------------------------------------------------------
# Modelo de texto — OPCIONAL
# ----------------------------------------------------------
# El modelo que usan el chat (E5) y el RAG (E4). Si se deja
# vacío se usa gemini-3.5-flash-lite.
#
# IMPORTA porque la cuota del plan gratuito es POR MODELO y
# POR DÍA. gemini-3.8-flash permite 20 peticiones al día, y
# los 14 casos de evaluación gastan unas 40: con ese modelo
# la evaluación no cabe en un día. Los modelos "lite" tienen
# cupo más amplio y aquí alcanzan de sobra, porque el modelo
# no calcula ninguna cifra —solo elige la herramienta y
# redacta—; las cifras las pone el núcleo.
#
# Si una corrida se topa con la cuota, cambie el modelo aquí
# en vez de esperar a que se renueve.
# GEMINI_MODELO=gemini-3.5-flash-lite


# ----------------------------------------------------------
# Opcionales
# ----------------------------------------------------------
# NO_COLOR=1      desactiva los colores de la consola
# RAG_DEBUG=1     imprime el detalle de la recuperación
# RAG_CASO=...    ejecuta un solo caso de las evaluaciones RAG
