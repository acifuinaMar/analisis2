{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",

    // La raiz es el proyecto y no src/ porque tests/ tambien se
    // type-chequea: con rootDir en src/, tsc rechaza todo lo de fuera.
    "rootDir": ".",
    "outDir": "./dist",

    "strict": true,

    "esModuleInterop": true,

    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },

  // tests/ entra a proposito. Las pruebas usan las mismas firmas que
  // el codigo, y si no se type-chequean un argumento equivocado pasa
  // en silencio: paso al agregar el perfil al orquestador, y lo
  // atraparon las pruebas en vez del compilador.
  "include": [
    "src/**/*",
    "tests/**/*"
  ],

  "exclude": [
    "node_modules",
    "dist"
  ]
}